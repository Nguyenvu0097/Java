<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><h2>Danh sách sinh viên</h2><a href="${pageContext.request.contextPath}/sinh-vien?action=new">Thêm</a><form><input name="keyword"><button>Tìm</button></form><table border="1"><tr><th>ID</th><th>Mã</th><th>Họ tên</th><th>Email</th><th>Lớp</th><th>Thao tác</th></tr><c:forEach var="x" items="${dsSinhVien}"><tr><td>${x.id}</td><td>${x.maSinhVien}</td><td><a href="${pageContext.request.contextPath}/sinh-vien?action=detail&id=${x.id}">${x.hoTen}</a></td><td>${x.email}</td><td>${x.lop}</td><td><a href="${pageContext.request.contextPath}/sinh-vien?action=edit&id=${x.id}">Sửa</a> | <a href="${pageContext.request.contextPath}/sinh-vien?action=delete&id=${x.id}">Xóa</a></td></tr></c:forEach></table>
