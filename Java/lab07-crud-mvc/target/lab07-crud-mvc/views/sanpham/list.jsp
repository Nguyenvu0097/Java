<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><h2>Quản lý sản phẩm</h2><a href="${pageContext.request.contextPath}/san-pham?action=new">Thêm</a><form><input name="keyword"><button>Tìm</button></form><table border="1"><tr><th>Mã</th><th>Tên</th><th>Giá</th><th>SL</th><th>Thao tác</th></tr><c:forEach var="x" items="${danhSach}"><tr><td>${x.ma}</td><td>${x.ten}</td><td>${x.gia}</td><td>${x.soLuong}</td><td><a href="${pageContext.request.contextPath}/san-pham?action=edit&id=${x.id}">Sửa</a> | <a href="${pageContext.request.contextPath}/san-pham?action=delete&id=${x.id}">Xóa</a></td></tr></c:forEach></table>
