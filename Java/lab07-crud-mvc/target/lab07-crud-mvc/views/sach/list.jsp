<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><h2>Quản lý sách</h2><a href="${pageContext.request.contextPath}/sach?action=new">Thêm</a><form><input name="keyword"><button>Tìm</button></form><table border="1"><tr><th>Mã</th><th>Tên</th><th>Tác giả</th><th>NXB</th><th>Năm</th><th>Thao tác</th></tr><c:forEach var="x" items="${danhSach}"><tr><td>${x.maSach}</td><td>${x.tenSach}</td><td>${x.tacGia}</td><td>${x.nhaXuatBan}</td><td>${x.namXuatBan}</td><td><a href="${pageContext.request.contextPath}/sach?action=edit&id=${x.id}">Sửa</a> | <a href="${pageContext.request.contextPath}/sach?action=delete&id=${x.id}">Xóa</a></td></tr></c:forEach></table>
